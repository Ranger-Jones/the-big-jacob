<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode signs development builds with "development" (sandbox APNs)
	     and rewrites it to "production" when exporting for TestFlight / ad hoc. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
